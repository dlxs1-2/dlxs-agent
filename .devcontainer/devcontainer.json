{
  "name": "Shift Host Machine",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2.13.0": {}
  },
  "customizations": {
    "codespaces": {
      "openPorts": ["4000", "3001", "3002", "3003", "3004", "3005"]
    }
  },
  "portsAttributes": {
    "4000": { "label": "Shift Agent", "onAutoForward": "silent", "visibility": "public" },
    "3001-3005": { "label": "User Apps", "onAutoForward": "silent", "visibility": "public" }
  },
   
  "postCreateCommand": "curl -sL ${GATEWAY_URL}/api/internal/download-agent -o agent.js || echo 'Using local agent' && node agent.js"
}